NODE_ENV=development
PORT=4000

# Replace every placeholder before starting the API. Never commit the resulting .env file.
DATABASE_URL=postgresql://YOUR_DATABASE_USER:YOUR_DATABASE_PASSWORD@localhost:5432/hospital_management?schema=public
CORS_ORIGIN=http://localhost:5173

# Generate independent secrets with at least 32 random characters.
JWT_ACCESS_SECRET=replace-with-a-random-access-secret-at-least-32-characters
JWT_REFRESH_SECRET=replace-with-a-random-refresh-secret-at-least-32-characters
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

BCRYPT_SALT_ROUNDS=12
LOG_LEVEL=info
