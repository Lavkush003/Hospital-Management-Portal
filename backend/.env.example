NODE_ENV=development
PORT=4000

# Replace every placeholder before starting the API. Never commit the resulting .env file.
DATABASE_URL=postgresql://YOUR_DATABASE_USER:YOUR_DATABASE_PASSWORD@localhost:5432/hospital_management?schema=public
CORS_ORIGIN=http://localhost:5173

# Generate independent secrets with at least 32 random characters.
JWT_ACCESS_SECRET=replace-with-a-random-access-secret-at-least-32-characters
JWT_REFRESH_SECRET=replace-with-a-random-refresh-secret-at-least-32-characters
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# In-memory fixed-window throttles for login and token refresh endpoints.
AUTH_LOGIN_RATE_LIMIT_WINDOW_MS=900000
AUTH_LOGIN_RATE_LIMIT_MAX=10
AUTH_REFRESH_RATE_LIMIT_WINDOW_MS=900000
AUTH_REFRESH_RATE_LIMIT_MAX=60

BCRYPT_SALT_ROUNDS=12
LOG_LEVEL=info

# Optional: use this password for all synthetic seed users. If omitted, the seed
# generates a random password and prints it once. Must be at least 12 characters.
SEED_DEFAULT_PASSWORD=
# Production seeding is refused unless this is explicitly set to true.
# SEED_ALLOW_PRODUCTION=false
