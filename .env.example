# This repository uses per-workspace env files.
# Copy the templates before running:
#
#   Copy-Item backend/.env.example backend/.env
#   Copy-Item frontend/.env.example frontend/.env
#
# The API reads backend/.env. The Vite app reads frontend/.env.
# Root-level .env files are not loaded by either workspace.

# Backend (backend/.env)
# NODE_ENV=development
# PORT=4000
# MONGODB_URI=mongodb://localhost:27017/hospital_management
# CORS_ORIGIN=http://localhost:5173
# JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long
# JWT_EXPIRES_IN=8h
# AUTH_COOKIE_NAME=hms_token
# BCRYPT_SALT_ROUNDS=10
# SEED_DEFAULT_PASSWORD=HospitalPass123!
# LOG_LEVEL=info

# Frontend (frontend/.env)
# VITE_API_BASE_URL=/api
# VITE_PROXY_TARGET=http://localhost:4000
